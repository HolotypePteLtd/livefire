---
import '../styles/landing.css';

const description = 'Hosted multiplayer rooms for games, with shared state, server-side physics, and text chat.';
const quickstart = `import { Livefire } from 'openfire-sdk';
const game = await Livefire.join({ url, joinToken, name: 'Alice' });
game.chat.send('Hello!');`;
const agentDocs = new URL('/llms-full.txt', Astro.site);
const agentPrompt = `Integrate hosted Livefire into this project.
Read ${agentDocs}

Inspect the existing backend and client. Add a flow that creates one room and joins it from two clients with separate one-time tokens. Keep LIVEFIRE_API_KEY on the backend. Show me how to configure and test it.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Livefire — Hosted multiplayer rooms</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('starlight-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.style.colorScheme = theme;
      } catch { /* Use the system theme when storage is unavailable. */ }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="bar wrap">
        <a class="wordmark" href="/" aria-label="Livefire home"><img src="/favicon.svg" alt="" width="28" height="28" />Livefire</a>
        <nav aria-label="Main navigation">
          <a href="/docs/">Documentation</a>
          <a href="#coding-agents">Agent prompt</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="intro">
        <div class="hero-layout wrap">
          <h1 id="intro">Multiplayer <span>rooms</span></h1>
          <div>
            <p class="lede">Add multiplayer to your game. Livefire hosts the rooms and handles shared state, server-side physics, and text chat.</p>
            <div class="actions">
              <a class="primary" href="/docs/hosted/">Hosted quickstart</a>
            </div>
          </div>
        </div>
      </section>

      <div class="snippets wrap">
        <section class="snippet" aria-labelledby="quickstart">
          <header>
            <h2 id="quickstart">Join a room in TypeScript</h2>
            <button type="button" data-copy="quickstart-code" hidden>Copy code</button>
          </header>
          <pre aria-label="TypeScript client example" tabindex="0"><code id="quickstart-code">{quickstart}</code></pre>
          <div class="snippet-footer">
            <a href="/docs/hosted/">Get a preview key and set up the SDK</a>
            <span role="status"></span>
          </div>
        </section>

        <section class="snippet" aria-labelledby="coding-agents">
          <header>
            <h2 id="coding-agents">Prompt for your coding agent</h2>
            <button type="button" data-copy="agent-prompt" hidden>Copy prompt</button>
          </header>
          <p class="agent-prompt" id="agent-prompt">{agentPrompt}</p>
          <div class="snippet-footer">
            <a href="/llms-full.txt">Open the plain-text docs</a>
            <span role="status"></span>
          </div>
        </section>
      </div>

      <div class="demo-section wrap">
        <figure class="room-demo" aria-labelledby="demo-title">
          <figcaption>
            <h2 id="demo-title">Two players, one room</h2>
            <p>Drag in your view, or click it and use the arrow keys. Watch your blue player move in the red bot’s view too. The room server runs in this tab.</p>
          </figcaption>
          <div id="world-demo-frames" class="world-demo-grid"></div>
          <noscript><p>Enable JavaScript to play the WebGL demo.</p></noscript>
          <script is:inline src="/world/orchestrator.js" defer></script>
        </figure>
      </div>

      <section class="details wrap" aria-labelledby="room-types">
        <h2 id="room-types">Room types</h2>
        <div class="descriptions">
          <div>
            <h3>Shared state</h3>
            <p>When a player picks a character or marks themselves ready, everyone in the lobby sees the change. The server checks who can write each value.</p>
            <a class="text-link" href="/docs/shared-state-rooms/">Configure a lobby</a>
            <a class="text-link" href="/demo/">Play the counter demo</a>
          </div>
          <div>
            <h3>Physics</h3>
            <p>Players send movement and jump inputs. The server applies gravity and collisions, then sends the resulting positions to each client.</p>
            <a class="text-link" href="/docs/physics-rooms/">Run a physics room</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <label hidden id="theme-control">Appearance
        <select id="theme">
          <option value="auto">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
    </footer>
    <script>
      if (navigator.clipboard?.writeText) {
        for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
          const snippet = document.getElementById(button.dataset.copy!);
          const status = button.closest('.snippet')?.querySelector('[role="status"]');
          if (!snippet || !status) continue;

          button.hidden = false;
          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(snippet.textContent ?? '');
              status.textContent = 'Copied.';
            } catch {
              status.textContent = 'Select the text to copy it.';
            }
          });
        }
      }

      const select = document.querySelector<HTMLSelectElement>('#theme')!;
      select.value = document.documentElement.style.colorScheme || 'auto';
      document.querySelector<HTMLLabelElement>('#theme-control')!.hidden = false;
      select.addEventListener('change', () => {
        const mode = select.value === 'auto' ? '' : select.value;
        document.documentElement.style.colorScheme = mode;
        try { localStorage.setItem('starlight-theme', mode); } catch { /* Apply for this page. */ }
      });
    </script>
  </body>
</html>
