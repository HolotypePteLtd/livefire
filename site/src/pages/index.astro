              <li class="reveal" style={`--d:${i * 80}ms`}>
                <span class="stepnum">{s.n}</span>
                <h3>
                  <a href={s.href}>
                    {s.title}
                    <span class="mi" set:html={icons.arrow} />
                  </a>
                </h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="use-cases" class="wrap">
        <div class="section-head reveal">
          <p class="kicker">// game modes</p>
          <h2>What people build</h2>
          <p class="section-sub">
            Two room types cover the spectrum — players decide, or the
            server decides.
          </p>
        </div>
        <div class="grid2 cards">
          {
            useCases.map((u, i) => (
              <article class={`card mode reveal`} style={`--d:${i * 60}ms`}>
                <div class="mode-head">
                  <span class="card-icon" set:html={icons[u.icon]} />
                  <span class={`mode-tag tag-${u.tag === 'authoritative' ? 'ember' : 'cyan'}`}>{u.tag}</span>
                </div>
                <h3>{u.title}</h3>
                <p>{u.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="pricing" class="wrap pricing">
        <div class="section-head reveal">
          <p class="kicker">// editions</p>
          <h2>Pricing</h2>
          <p class="section-sub">
            Self-host free, today. The hosted node is live in preview — API
            key on request — and paid tiers are still on the roadmap.
          </p>
        </div>
        <div class="grid3 cards">
          {
            tiers.map((t, i) => (
              <article
                class={`card tier${t.comingSoon ? ' soon' : ' featured'} reveal`}
                style={`--d:${i * 80}ms`}
              >
                <h3>
                  {t.name} <span class="tag">{t.tag}</span>
                  {t.comingSoon && <span class="badge">Coming soon</span>}
                  {t.badge && <span class="badge live">{t.badge}</span>}
                </h3>
                <p class="price">{t.price}</p>
                <p>{t.body}</p>
                {t.cta && (
                  <p class="tier-cta">
                    <a class="button primary" href={t.cta.href}>
                      {t.cta.label}
                      <span class="mi" set:html={icons.arrow} />
                    </a>
                  </p>
                )}
                {t.note && <p class="tier-note">{t.note}</p>}
              </article>
            ))
          }
        </div>
        <p class="run reveal">
          The hosted node runs at
          <a href="https://play.holotype.com.sg">play.holotype.com.sg</a> —
          API keys on request while the preview runs; self-serve signup and
          billing are still coming. The self-hosted server is free today,
          under the MIT license.
        </p>
      </section>

      <section id="faq" class="wrap faq">
        <div class="section-head reveal">
          <p class="kicker">// intel</p>
          <h2>Questions</h2>
        </div>
        <div class="reveal">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="wrap">
        <div class="cta-band reveal">
          <p class="kicker">// ready player one</p>
          <h2>Get your game online this afternoon.</h2>
          <p>
            Run the demo, point a domain at a server, create your first
            room — one page, start to finish.
          </p>
          <p class="cta">
            <a class="button primary" href="/docs/multiplayer-server/">
              Get started
              <span class="mi" set:html={icons.arrow} />
            </a>
            <a class="button" href={repo}>
              <span class="mi" set:html={icons.github} />Star on GitHub
            </a>
          </p>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <div class="footer-cols">
        <div>
          <span class="logo">
            <span class="logo-mark" aria-hidden="true"></span>
            Open<span class="accent">fire</span>
          </span>
          <p class="run">
            Open-source multiplayer rooms. MIT license ·
            © 2026 Holotype Pte Ltd.
          </p>
        </div>
        <nav aria-label="Docs">
          <h4>Docs</h4>
          {
            docsLinks.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))
          }
        </nav>
        <nav aria-label="Project">
          <h4>Project</h4>
          <a href={repo}>GitHub</a>
          <a href="/docs/protocol/">Wire protocol</a>
          <a href="/spec/rooms-protocol.json">rooms-protocol.json</a>
          <a href="/llms.txt">llms.txt</a>
        </nav>
      </div>
    </footer>

    <script>
      // Landing behaviors — no framework. Everything degrades gracefully:
      // without JS the page is fully readable, all sections visible, FAQ
      // native <details>, links native anchors.

      const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Sticky header state -------------------------------------------------
      const top = document.querySelector<HTMLElement>('.top')!;
      const onScroll = () => top.classList.toggle('scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // --- Mobile menu ---------------------------------------------------------
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const nav = document.getElementById('site-nav')!;
      const setMenu = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('open', open);
        document.body.classList.toggle('menu-open', open);
      };
      toggle.addEventListener('click', () =>
        setMenu(toggle.getAttribute('aria-expanded') !== 'true'),
      );
      nav.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setMenu(false);
      });
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
      // If the viewport grows past the mobile breakpoint, drop menu state.
      matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false);
      });

      // --- Scroll spy ----------------------------------------------------------
      const spyLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[data-spy]')];
      const spyTargets = spyLinks
        .map((a) => document.querySelector(a.getAttribute('href')!))
        .filter(Boolean) as Element[];
      if ('IntersectionObserver' in window && spyTargets.length) {
        const visible = new Map<Element, number>();
        const spy = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) visible.set(en.target, en.intersectionRatio);
              else visible.delete(en.target);
            }
            let best: Element | null = null;
            let bestRatio = 0;
            for (const [el, ratio] of visible) {
              if (ratio > bestRatio) {
                best = el;
                bestRatio = ratio;
              }
            }
            for (const a of spyLinks) {
              const active = best !== null && a.getAttribute('href') === `#${best.id}`;
              a.classList.toggle('active', active);
              if (active) a.setAttribute('aria-current', 'true');
              else a.removeAttribute('aria-current');
            }
          },
          // Band around the upper-middle of the viewport so exactly one
          // section reads as "current" while scrolling.
          { rootMargin: '-25% 0px -55% 0px', threshold: [0, 0.1, 0.5, 1] },
        );
        spyTargets.forEach((t) => spy.observe(t));
      }

      // --- Reveal on scroll ------------------------------------------------------
      const reveals = [...document.querySelectorAll<HTMLElement>('.reveal')];
      if (prefersReduced || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('in'));
      } else {
        const ro = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                (en.target as HTMLElement).classList.add('in');
                ro.unobserve(en.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        reveals.forEach((el) => ro.observe(el));
      }

      // --- Copy buttons -----------------------------------------------------------
      for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy')) {
        btn.addEventListener('click', async () => {
          const text = btn.dataset.copy ?? '';
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            // Clipboard API can fail on http origins / older browsers —
            // fall back to a hidden textarea + execCommand.
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try {
              document.execCommand('copy');
            } finally {
              ta.remove();
            }
          }
          btn.classList.add('done');
          setTimeout(() => btn.classList.remove('done'), 1600);
        });
      }

      // --- Hero HUD: authoritative-room topology --------------------------------
      // A small canvas diagram: the server node at center, three player
      // clients around it; command packets travel inward (cyan), snapshot
      // packets outward (amber). Authentic frame names from the wire spec.
      // Pauses when off-screen or when the tab is hidden; static frame for
      // reduced motion.
      const canvas = document.querySelector<HTMLCanvasElement>('.hud-canvas');
      const tickEl = document.querySelector<HTMLElement>('[data-hud-tick]');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          const AMBER = '#F5A54A';
          const CYAN = '#57C8DE';
          const GREEN = '#57D9A3';
          const LINE = 'rgba(151, 161, 181, 0.28)';
          const TEXT = '#97A1B5';
          const clients = [
            { label: 'alice', angle: -Math.PI / 2 },
            { label: 'bob', angle: Math.PI / 6 },
            { label: 'sam', angle: (5 * Math.PI) / 6 },
          ];
          const outLabels = ['snapshot', 'state', 'social'];
          const inLabels = ['input', 'command', 'chat'];
          type Packet = { link: number; out: boolean; t: number; speed: number; label: string };
          let packets: Packet[] = [];
          let raf = 0;
          let running = false;
          let last = 0;
          let simTick = 1200;
          let spawnClock = 0;
          let W = 0;
          let H = 0;
          let dpr = 1;

          const resize = () => {
            const rect = canvas.getBoundingClientRect();
            dpr = Math.min(devicePixelRatio || 1, 2);
            W = rect.width;
            H = rect.height;
            canvas.width = Math.round(W * dpr);
            canvas.height = Math.round(H * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            if (prefersReduced) drawStatic();
          };

          const geom = () => {
            const cx = W / 2;
            const cy = H / 2;
            const r = Math.min(W, H) * 0.36;
            return {
              cx,
              cy,
              peers: clients.map((c) => ({
                x: cx + Math.cos(c.angle) * r * (W > H ? 1.25 : 1),
                y: cy + Math.sin(c.angle) * r,
                label: c.label,
              })),
            };
          };

          const node = (x: number, y: number, r: number, color: string, label: string, below: boolean) => {
            ctx.beginPath();
            ctx.arc(x, y, r + 5, 0, Math.PI * 2);
            ctx.strokeStyle = color + '33';
            ctx.lineWidth = 1;
            ctx.stroke();
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fillStyle = '#12151D';
            ctx.fill();
            ctx.strokeStyle = color;
            ctx.lineWidth = 1.5;
            ctx.stroke();
            ctx.fillStyle = TEXT;
            ctx.font = '10px ui-monospace, Menlo, monospace';
            ctx.textAlign = 'center';
            ctx.fillText(label, x, below ? y + r + 16 : y - r - 9);
          };

          const drawBase = (g: ReturnType<typeof geom>) => {
            ctx.clearRect(0, 0, W, H);
            // faint grid
            ctx.strokeStyle = 'rgba(151, 161, 181, 0.05)';
            ctx.lineWidth = 1;
            const step = 26;
            for (let x = step; x < W; x += step) {
              ctx.beginPath();
              ctx.moveTo(x, 0);
              ctx.lineTo(x, H);
              ctx.stroke();
            }
            for (let y = step; y < H; y += step) {
              ctx.beginPath();
              ctx.moveTo(0, y);
              ctx.lineTo(W, y);
              ctx.stroke();
            }
            // links
            ctx.strokeStyle = LINE;
            ctx.setLineDash([3, 5]);
            for (const p of g.peers) {
              ctx.beginPath();
              ctx.moveTo(g.cx, g.cy);
              ctx.lineTo(p.x, p.y);
              ctx.stroke();
            }
            ctx.setLineDash([]);
          };

          const drawNodes = (g: ReturnType<typeof geom>) => {
            node(g.cx, g.cy, 15, AMBER, 'authority', false);
            // inner core dot
            ctx.beginPath();
            ctx.arc(g.cx, g.cy, 4, 0, Math.PI * 2);
            ctx.fillStyle = AMBER;
            ctx.fill();
            g.peers.forEach((p, i) => node(p.x, p.y, 9, i === 1 ? GREEN : CYAN, p.label, p.y > g.cy));
          };

          const drawStatic = () => {
            const g = geom();
            drawBase(g);
            // one frozen packet per link for a meaningful still image
            for (let i = 0; i < g.peers.length; i++) {
              const p = g.peers[i];
              const t = 0.45 + i * 0.12;
              const x = g.cx + (p.x - g.cx) * t;
              const y = g.cy + (p.y - g.cy) * t;
              ctx.beginPath();
              ctx.arc(x, y, 3, 0, Math.PI * 2);
              ctx.fillStyle = i % 2 ? CYAN : AMBER;
              ctx.fill();
            }
            drawNodes(g);
            if (tickEl) tickEl.textContent = String(simTick);
          };

          const frame = (now: number) => {
            if (!running) return;
            const dt = Math.min((now - last) / 1000, 0.05);
            last = now;
            simTick += dt * 60;
            if (tickEl) tickEl.textContent = String(Math.floor(simTick));

            spawnClock -= dt;
            if (spawnClock <= 0) {
              spawnClock = 0.28 + Math.random() * 0.3;
              const link = Math.floor(Math.random() * 3);
              const out = Math.random() < 0.55;
              packets.push({
                link,
                out,
                t: 0,
                speed: 0.55 + Math.random() * 0.35,
                label: out
                  ? outLabels[Math.floor(Math.random() * outLabels.length)]
                  : inLabels[Math.floor(Math.random() * inLabels.length)],
              });
              if (packets.length > 14) packets = packets.slice(-14);
            }

            const g = geom();
            drawBase(g);
            ctx.font = '9px ui-monospace, Menlo, monospace';
            for (const pk of packets) {
              pk.t += pk.speed * dt;
              const p = g.peers[pk.link];
              const t = pk.out ? pk.t : 1 - pk.t;
              const x = g.cx + (p.x - g.cx) * t;
              const y = g.cy + (p.y - g.cy) * t;
              const color = pk.out ? AMBER : CYAN;
              // trail
              const tt = pk.out ? Math.max(t - 0.07, 0) : Math.min(t + 0.07, 1);
              ctx.strokeStyle = color + '55';
              ctx.lineWidth = 2;
              ctx.beginPath();
              ctx.moveTo(g.cx + (p.x - g.cx) * tt, g.cy + (p.y - g.cy) * tt);
              ctx.lineTo(x, y);
              ctx.stroke();
              ctx.beginPath();
              ctx.arc(x, y, 2.6, 0, Math.PI * 2);
              ctx.fillStyle = color;
              ctx.fill();
              if (pk.t > 0.25 && pk.t < 0.75) {
                ctx.fillStyle = color + 'AA';
                ctx.textAlign = 'center';
                ctx.fillText(pk.label, x, y - 8);
              }
            }
            packets = packets.filter((p) => p.t < 1);
            drawNodes(g);
            raf = requestAnimationFrame(frame);
          };

          const start = () => {
            if (running || prefersReduced) return;
            running = true;
            last = performance.now();
            raf = requestAnimationFrame(frame);
          };
          const stop = () => {
            running = false;
            cancelAnimationFrame(raf);
          };

          resize();
          addEventListener('resize', resize, { passive: true });
          if (prefersReduced) {
            drawStatic();
          } else {
            // Only animate while visible on screen and the tab is focused.
            const vis = new IntersectionObserver(
              (entries) => {
                for (const en of entries) {
                  if (en.isIntersecting && !document.hidden) start();
                  else stop();
                }
              },
              { threshold: 0.1 },
            );
            vis.observe(canvas);
            document.addEventListener('visibilitychange', () => {
              if (document.hidden) stop();
              else {
                const rect = canvas.getBoundingClientRect();
                if (rect.bottom > 0 && rect.top < innerHeight) start();
              }
            });
          }
        }
      }
    </script>
  </body>
</html>