---
import '../styles/landing.css';

const description = 'Hosted multiplayer rooms for games, with shared state, server-side physics, and text chat.';
const quickstart = `import { Livefire } from 'openfire-sdk';
const game = await Livefire.join({ url, joinToken, name: 'Alice' });
game.chat.send('Hello!');`;
const agentDocs = new URL('/llms-full.txt', Astro.site);
const agentPrompt = `integrate Livefire into this project for real-time multiplayer
${agentDocs}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>Livefire — Hosted multiplayer rooms</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/barlow-condensed-bold.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="bar wrap">
        <a class="wordmark" href="/" aria-label="Livefire home"><img src="/favicon.svg" alt="" width="28" height="28" />Livefire</a>
        <nav aria-label="Main navigation">
          <a href="/docs/">Documentation</a>
          <a href="#coding-agents">Agent prompt</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="intro">
        <div class="hero-art" aria-hidden="true">
          <span class="facet facet-left"></span>
          <span class="facet facet-right"></span>
          <span class="facet facet-bottom"></span>
        </div>
        <div class="hero-layout wrap">
          <div>
            <h1 id="intro">Instant real-time <span>multiplayer</span></h1>
            <p class="lede">Livefire hosts your game’s rooms and handles shared state, server-side physics, and text chat.</p>
            <div class="actions">
              <a class="primary" href="/docs/hosted/">Hosted quickstart</a>
            </div>
          </div>

          <div class="snippets">
            <div class="snippet">
              <div class="snippet-box vector-panel">
                <pre aria-label="TypeScript client example" tabindex="0"><code id="quickstart-code">{quickstart}</code></pre>
                <button type="button" class="copy-button" data-copy="quickstart-code" aria-label="Copy code" title="Copy code" hidden>
                  <span aria-hidden="true"></span>
                </button>
              </div>
              <span class="visually-hidden" role="status"></span>
            </div>

            <section class="snippet" aria-labelledby="coding-agents">
              <h2 id="coding-agents">or copy prompt for your coding agent</h2>
              <div class="snippet-box vector-panel">
                <p class="agent-prompt" id="agent-prompt">{agentPrompt}</p>
                <button type="button" class="copy-button" data-copy="agent-prompt" aria-label="Copy prompt" title="Copy prompt" hidden>
                  <span aria-hidden="true"></span>
                </button>
              </div>
              <span class="visually-hidden" role="status"></span>
            </section>
          </div>
        </div>
      </section>

      <div class="demo-section wrap">
        <figure class="room-demo vector-panel" aria-labelledby="demo-title">
          <figcaption>
            <h2 id="demo-title">Two players, one room</h2>
            <p>Drag in your view, or click it and use the arrow keys. Watch your blue player move in the red bot’s view too. The room server runs in this tab.</p>
          </figcaption>
          <div id="world-demo-frames" class="world-demo-grid"></div>
          <noscript><p>Enable JavaScript to play the WebGL demo.</p></noscript>
          <script is:inline src="/world/orchestrator.js" defer></script>
        </figure>
      </div>

      <section class="details wrap" aria-labelledby="room-types">
        <h2 id="room-types">Room types</h2>
        <div class="descriptions">
          <div>
            <h3>Shared state</h3>
            <p>When a player picks a character or marks themselves ready, everyone in the lobby sees the change. The server checks who can write each value.</p>
            <a class="text-link" href="/docs/shared-state-rooms/">Configure a lobby</a>
            <a class="text-link" href="/demo/">Play the counter demo</a>
          </div>
          <div>
            <h3>Physics</h3>
            <p>Players send movement and jump inputs. The server applies gravity and collisions, then sends the resulting positions to each client.</p>
            <a class="text-link" href="/docs/physics-rooms/">Run a physics room</a>
          </div>
        </div>
      </section>
    </main>

    <script>
      if (navigator.clipboard?.writeText) {
        for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
          const snippet = document.getElementById(button.dataset.copy!);
          const status = button.closest('.snippet')?.querySelector('[role="status"]');
          if (!snippet || !status) continue;

          let resetIcon: ReturnType<typeof setTimeout>;
          button.hidden = false;
          button.addEventListener('click', async () => {
            clearTimeout(resetIcon);
            status.textContent = '';
            try {
              await navigator.clipboard.writeText(snippet.textContent ?? '');
              button.classList.add('copied');
              status.textContent = 'Copied.';
              resetIcon = setTimeout(() => button.classList.remove('copied'), 1500);
            } catch {
              button.classList.remove('copied');
              status.textContent = 'Select the text to copy it.';
            }
          });
        }
      }
    </script>
  </body>
</html>
