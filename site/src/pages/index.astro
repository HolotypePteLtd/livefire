---
import '../styles/landing.css';

const repo = 'https://github.com/HolotypePteLtd/livefire';
const description = 'An open-source multiplayer server with shared state, chat, and physics. Host it on your own domain and connect players over WebSocket.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Livefire — Multiplayer room server</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('starlight-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.style.colorScheme = theme;
      } catch { /* Use the system theme when storage is unavailable. */ }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="bar wrap">
        <a class="wordmark" href="/" aria-label="Livefire home"><img src="/favicon.svg" alt="" width="28" height="28" />Livefire</a>
        <nav aria-label="Main navigation">
          <a href="/docs/">Documentation</a>
          <a href={repo}>GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="intro">
        <div class="hero-layout wrap">
          <div>
            <h1 id="intro">Multiplayer <span>rooms</span></h1>
            <p class="lede">Livefire is an open-source game server. Your backend creates rooms over HTTP. Players join over WebSocket to chat, share state, or send movement inputs.</p>
            <div class="actions">
              <a class="primary" href="/docs/multiplayer-server/">Run a room locally</a>
              <a class="text-link" href="/docs/self-hosting/">Deploy with Docker</a>
            </div>
          </div>

          <figure class="room-demo" aria-labelledby="demo-title">
            <figcaption>
              <h2 id="demo-title">Counter demo</h2>
              <p>Alice and Bob are bots running in this tab. Add a point or send a message to join them.</p>
            </figcaption>
            <div id="demo-root"><p>Starting the room…</p></div>
            <noscript><p>Enable JavaScript to play, or <a href="/docs/multiplayer-server/">run the example locally</a>.</p></noscript>
            <script is:inline type="module" src="/demo/boot.mjs"></script>
          </figure>
        </div>
      </section>

      <section class="details wrap" aria-labelledby="room-types">
        <h2 id="room-types">Room types</h2>
        <div class="descriptions">
          <div>
            <h3>Shared state</h3>
            <p>When a player picks a character or marks themselves ready, everyone in the lobby sees the change. The server checks who can write each value.</p>
            <a class="text-link" href="/docs/shared-state-rooms/">Configure a lobby</a>
          </div>
          <div>
            <h3>Physics</h3>
            <p>Players send movement and jump inputs. The server applies gravity and collisions, then sends the resulting positions to each client.</p>
            <a class="text-link" href="/docs/multiplayer-server/#watch-two-players-share-one-world">Try the movement demo</a>
          </div>
        </div>
      </section>

      <section class="details wrap" aria-labelledby="hosting">
        <h2 id="hosting">Hosting and accounts</h2>
        <div class="descriptions">
          <div>
            <h3>On your server</h3>
            <p>Run Livefire on your domain with Docker Compose and HTTPS. Connect with the Dart or TypeScript SDK. To add custom game rules, write a room in Dart.</p>
            <a class="text-link" href="/docs/self-hosting/">Self-hosting guide</a>
            <a class="text-link" href="/docs/multiplayer-server/#hosted-preview">Hosted preview</a>
          </div>
          <div>
            <h3>Player sign-in</h3>
            <p>Guests join with a one-time token. Players can sign in with an existing AT Protocol account, or you can create guest accounts on your own Personal Data Server (PDS).</p>
            <a class="text-link" href="/docs/self-hosting/#already-run-a-pds">Use an existing PDS</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <a href={repo + '/blob/master/LICENSE'}>MIT license</a>
      <label hidden id="theme-control">Appearance
        <select id="theme">
          <option value="auto">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
    </footer>
    <script>
      const select = document.querySelector<HTMLSelectElement>('#theme')!;
      select.value = document.documentElement.style.colorScheme || 'auto';
      document.querySelector<HTMLLabelElement>('#theme-control')!.hidden = false;
      select.addEventListener('change', () => {
        const mode = select.value === 'auto' ? '' : select.value;
        document.documentElement.style.colorScheme = mode;
        try { localStorage.setItem('starlight-theme', mode); } catch { /* Apply for this page. */ }
      });
    </script>
  </body>
</html>
