// Integration snippets for the "From zero to live" section. Each is the
// real API, compressed to the smallest thing that actually works; the
// room code below is executed verbatim as part of this site's checks,
// and both config blocks are parsed by the node's own config loader.
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Minimal build-time syntax tint for the landing snippets (comments,
// strings, a few keywords) — a character scanner, not a highlighter
// dependency. `//` starts a comment unless it is part of a URI (`://`).
const hl = (src: string): string => {
  let out = '';
  let i = 0;
  const n = src.length;
  const kw = /\b(import|from|const|await|true|false|new)\b/g;
  const plain = (s: string) =>
    esc(s).replace(kw, '<span class="tok-k">$1</span>');
  while (i < n) {
    const ch = src[i];
    if (ch === "'" || ch === '"') {
      let j = i + 1;
      while (j < n && src[j] !== ch) {
        if (src[j] === '\\') j++;
        if (src[j] === '\n') break; // unterminated: stop at EOL
        j++;
      }
      const end = Math.min(j + 1, n);
      out += `<span class="tok-s">${esc(src.slice(i, end))}</span>`;
      i = end;
    } else if (ch === '/' && src[i + 1] === '/' && src[i - 1] !== ':') {
      let j = src.indexOf('\n', i);
      if (j === -1) j = n;
      out += `<span class="tok-c">${esc(src.slice(i, j))}</span>`;
      i = j;
    } else {
      let j = i;
      while (j < n) {
        const c = src[j];
        if (c === "'" || c === '"') break;
        if (c === '/' && src[j + 1] === '/' && src[j - 1] !== ':') break;
        j++;
      }
      out += plain(src.slice(i, j));
      i = j;
    }
  }
  return out;
};

