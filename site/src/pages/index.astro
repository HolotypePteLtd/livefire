---
import '../styles/landing.css';

const repo = 'https://github.com/HolotypePteLtd/livefire';
const description = 'Livefire is an open-source multiplayer server for games. Host rooms with shared state, chat, and server-side physics.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Livefire — Multiplayer rooms for your game</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('starlight-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.style.colorScheme = theme;
      } catch { /* Use the system theme when storage is unavailable. */ }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead wrap">
      <a class="wordmark" href="/" aria-label="Livefire home"><img src="/favicon.svg" alt="" width="28" height="28" />Livefire</a>
      <nav aria-label="Main navigation">
        <a href="/docs/">Documentation</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="intro">
        <div>
          <h1 id="intro">Multiplayer rooms <em>for your game.</em></h1>
          <p class="lede">Livefire is an open-source multiplayer server. Use it for lobby chat, shared game state, and movement that your server simulates. Connect players from a browser, phone, or desktop game.</p>
          <div class="actions">
            <a class="primary" href="/docs/multiplayer-server/">Run your first room</a>
            <a class="text-link" href="/docs/">Read the docs</a>
          </div>
        </div>

        <figure class="room-demo" aria-labelledby="demo-title">
          <figcaption>
            <h2 id="demo-title">Counter room</h2>
            <p>Alice and Bob are scripted players. Send a message or add a point to join them in this tab.</p>
          </figcaption>
          <div id="demo-root">
            <p class="demo-loading">Starting the room…</p>
          </div>
          <noscript><p>Enable JavaScript to play, or <a href="/docs/multiplayer-server/">run the example locally</a>.</p></noscript>
          <script is:inline type="module" src="/demo/boot.mjs"></script>
        </figure>
      </section>

      <section class="details wrap" aria-labelledby="room-types">
        <h2 id="room-types">What happens <br />in a room?</h2>
        <div class="descriptions">
          <div>
            <h3>In the lobby</h3>
            <p>Players can chat, choose a character, and mark themselves ready. A shared state room sends those changes to everyone. The room leader can lock the lobby when the match starts.</p>
          </div>
          <div>
            <h3>During play</h3>
            <p>In a physics room, clients send movement and jump inputs. The server applies speed and collision rules, then sends each player’s position back to the game. For custom rules, you can write the room logic in Dart.</p>
            <a class="text-link" href="/docs/multiplayer-server/#watch-two-players-share-one-world">Try the movement demo</a>
          </div>
        </div>
      </section>

      <section class="details wrap" aria-labelledby="hosting">
        <h2 id="hosting">Run it with <br />your game.</h2>
        <div class="descriptions">
          <div>
            <h3>Hosting</h3>
            <p>Run Livefire on your own domain with Docker Compose. Your backend creates rooms over HTTP. Players connect over WebSocket using the TypeScript or Dart SDK, or a client you write yourself.</p>
            <a class="text-link" href="/docs/self-hosting/">Host a server</a>
            <a class="text-link" href="/docs/multiplayer-server/#hosted-preview">Hosted preview</a>
          </div>
          <div>
            <h3>Player accounts</h3>
            <p>Players can join as guests or sign in with an existing AT Protocol account. If you already run a Personal Data Server, you can also use it to give guests a persistent identity.</p>
            <a class="text-link" href="/docs/self-hosting/#already-run-a-pds">Use an existing PDS</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <a href={repo + '/blob/master/LICENSE'}>MIT license</a>
      <label hidden id="theme-control">Appearance
        <select id="theme">
          <option value="auto">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
    </footer>
    <script>
      const select = document.querySelector<HTMLSelectElement>('#theme')!;
      select.value = document.documentElement.style.colorScheme || 'auto';
      document.querySelector<HTMLLabelElement>('#theme-control')!.hidden = false;
      select.addEventListener('change', () => {
        const mode = select.value === 'auto' ? '' : select.value;
        document.documentElement.style.colorScheme = mode;
        try { localStorage.setItem('starlight-theme', mode); } catch { /* Apply for this page. */ }
      });
    </script>
  </body>
</html>
