---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '../../styles/demo.css';
---

<StarlightPage frontmatter={{
  title: 'Counter room demo',
  description: 'Send a message and update a counter in a room running in your browser.',
  tableOfContents: false,
  prev: false,
  next: false,
  pagefind: false,
  head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } }],
}}>
  <p>Alice and Bob are bots running in this tab. Choose <strong>Add a point</strong> or send a message to join the room.</p>
  <div id="demo-root" class="not-content">
    <p>Loading the room engine…</p>
  </div>
  <noscript><p>The counter demo requires JavaScript.</p></noscript>
  <p><a href="/docs/multiplayer-server/">Run this room locally</a></p>
  <script is:inline type="module" src="/demo/boot.mjs"></script>
</StarlightPage>
