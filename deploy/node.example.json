{
  "publicBaseUrl": "https://rooms.example.com",
  "nodeSecret": "CHANGE-ME-generate-32+-random-characters",
  "apiKeys": {
    "default": "CHANGE-ME-service-key"
  },
  "dataDir": "/var/lib/rooms",
  "listen": { "port": 8787, "address": "0.0.0.0" },
  "allowedOrigins": ["https://game.example.com"],
  "limits": {
    "maxRooms": 256,
    "maxReservedCapacity": 4096,
    "idleTtlSeconds": 300,
    "connectionsPerIpPerMinute": 60
  },
  "joinTokenTtlSeconds": 900,
  "physics": true,
  "auth": {"providers": ["guest"]},
  "publishEvents": {
    "enabled": false,
    "gameId": "com.example.yourgame",
    "maxEventsPerMatch": 4,
    "summaryOnly": true
  }
}
